# --- Telegram ---
# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=123456789:replace-me
# Твой Telegram user ID: бот общается только с этим пользователем.
TELEGRAM_OWNER_ID=123456789
# Канал с недельными отчётами; бот должен быть в нём админом.
TELEGRAM_CHANNEL_ID=-1001234567890

# --- Jira (Basic auth) ---
JIRA_BASE_URL=https://jira.example.com
JIRA_USERNAME=john.doe
JIRA_PASSWORD=replace-me
# Единственная задача, в которую списываются все часы.
JIRA_ISSUE_KEY=ABC-1
# Время начала worklog'а для каждого дня, ЧЧ:ММ.
JIRA_WORKLOG_START_TIME=10:00
# Поля атрибутов WorklogPRO из успешного запроса браузера, в формате query-строки.
JIRA_WORKLOG_EXTRA_FIELDS=wa_1=1&wa_2=VALUE

# --- OpenVPN (поднимается только на время отправки) ---
OPENVPN_CONFIG=/etc/auto-time-report/client.ovpn
OPENVPN_USERNAME=john.doe
OPENVPN_PASSWORD=replace-me
# Подсети, которые идут через VPN (split tunnel), через запятую.
OPENVPN_ROUTES=10.0.0.0/8
# Сколько ждать поднятия туннеля, включая подтверждение пуша в Multifactor.
OPENVPN_CONNECT_TIMEOUT=90s

# --- Календарь и напоминания ---
TIMEZONE=Europe/Moscow
# API производственного календаря (выходные, праздники, сокращённые дни).
PRODUCTION_CALENDAR_URL=https://isdayoff.ru
# Расписание напоминаний настраивается в боте командой /settings.

# --- Хранилище (SQLite) ---
# Общая для бота и dbmate.
DATABASE_URL=sqlite:./data/bot.db
