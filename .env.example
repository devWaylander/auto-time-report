# Здесь только настройки

# --- Telegram ---
# Файл с токеном бота
TELEGRAM_BOT_TOKEN_FILE=./secrets/telegram_bot_token
# Telegram user ID
TELEGRAM_OWNER_ID=123456789
# Канал с недельными отчётами; бот должен быть в нём админом
TELEGRAM_CHANNEL_ID=-1001234567890
# Прокси только для Telegram, если api.telegram.org недоступен с сервера: http://, socks5:// или socks5h://.
# host.docker.internal - сам сервер. Jira и VPN через этот прокси не ходят. Пусто - напрямую
# TELEGRAM_PROXY_URL=socks5h://user:password@host.docker.internal:10808

# --- Jira ---
# Задача по умолчанию: в неё идут записи, если в посте не указаны иные задачи
JIRA_DEFAULT_ISSUE_KEY=ABC-1
# Время начала worklog'а для каждого дня, ЧЧ:ММ
JIRA_WORKLOG_START_TIME=10:00

# --- Корпоративные доступы ---
# Хранилище
CREDS_FILE=./secrets/creds.age
# Сколько ждать поднятия туннеля, включая подтверждение в двух-факторе
OPENVPN_CONNECT_TIMEOUT=90s

# --- Календарь и напоминания ---
# Твой часовой пояс: по нему считается "сегодня" и время напоминаний
TIMEZONE=Europe/Moscow
# API производственного календаря (выходные, праздники, сокращённые дни)
PRODUCTION_CALENDAR_URL=https://isdayoff.ru

# --- База (SQLite) ---
DATABASE_URL=sqlite:./data/bot.db
